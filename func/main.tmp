#include "User.hpp"

#define LINE std::cout << "----------------------" << std::endl

int main() {
	ChannelContainer Server;
	std::cout << "Now server start." << std::endl;
	User testOperator;
	std::cout << std::endl << "Enter the test guest's information." << std::endl;
	User testGuest;
	std::cout << std::endl << "Welcome." << std::endl;
	std::string command;
	std::cin.clear();
	while (true) {
		std::cout << "> ";
		if (!std::getline(std::cin, command))
			return 1;
		if (command == "CHEAT") {
			testOperator.setIsOperator(1);
			std::cout << "now you are operator." << std::endl;
		}
		else if (command == "JOIN") {
			std::string toJoin;
			std::cout << "Enter the channel name: ";
			std::cin >> toJoin;
			testOperator.joinChannel(toJoin, Server);
		}
		else if (command == "TOPIC") {
			std::string topic;
			std::cout << "Enter the topic: ";
			std::cin >> topic;
			(*testOperator.getJoinedChannel(Server)).getTopicRef().setTopic(topic);
		}
		else if (command == "INVITE") {
			testOperator.inviteUser(testGuest, Server);
		}
		else if (command == "KICK") {
			testOperator.kickUser(testGuest, Server);
		}
		else if (command == "MODE") {
			int type;
			std::cout << "what type: ";
			std::cin >> type;
			testOperator.changeMode(type, Server);
		}
		else if (command == "info") {
			LINE;
			if (testOperator.getJoinedChannelIndex() >= 0) {
				std::cout << "|channel name: " << (*testOperator.getJoinedChannel(Server)).getChannelName() << std::endl;
				LINE;
				std::cout << "|channel topic: " << (*testOperator.getJoinedChannel(Server)).getTopicRef().getTopic() << std::endl; 
				LINE;
				std::cout << "|channel mode: " << (*testOperator.getJoinedChannel(Server)).getModeRef().getType() << std::endl;
				LINE;
				std::cout << "|user list: " << std::endl;
				std::vector<User*>::iterator user_iter = (testOperator.getJoinedChannel(Server))->getUserList().begin();
				for (user_iter= (*testOperator.getJoinedChannel(Server)).getUserList().begin()\
				;user_iter != (*testOperator.getJoinedChannel(Server)).getUserList().end()\
				;user_iter++) {
					std::cout << "|          ";
					std::cout << "|" << (*user_iter)->getNickName() << std::endl;
				}
			}
			else
				std::cout << "|channel: not joined." << std::endl;
			LINE;
			if (testOperator.getIsOperator())
				std::cout << "|Operator: TRUE" << std::endl;
			else
				std::cout << "|Operator: FALSE" << std::endl;
			LINE;
		}
		else
			std::cerr << "no such command." << std::endl;
		std::cin.clear();
	}

}